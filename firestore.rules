rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function ok(){return request.auth!=null&&exists(/databases/$(d)/documents/users/$(request.auth.uid));}
 function role(){return get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role;}
 match /users/{u}{allow read:if request.auth!=null&&request.auth.uid==u;allow write:if false;}
 match /projects/{i}{allow read:if ok();allow write:if ok()&&role() in ['admin','accountant'];}
 match /expenses/{i}{allow read:if ok();allow create:if ok()&&role()!='manager';allow update,delete:if ok()&&role() in ['admin','accountant'];}
 match /invoices/{i}{allow read:if ok()&&role()!='entry';allow create:if ok()&&role() in ['admin','accountant','entry'];allow update,delete:if ok()&&role() in ['admin','accountant'];}
 match /categories/{i}{allow read:if ok();allow create:if ok()&&role()!='manager';allow update,delete:if ok()&&role() in ['admin','accountant'];}
 match /accounts/{i}{allow read:if ok();allow write:if ok()&&role() in ['admin','accountant'];}
 match /funds/{i}{allow read:if ok()&&role()!='entry';allow write:if ok()&&role() in ['admin','accountant'];}
 match /attachments/{i}{allow read:if ok();allow create:if ok()&&role()!='manager';allow delete:if ok()&&role() in ['admin','accountant'];}
 match /audit/{i}{allow read:if ok()&&role()!='entry';allow create:if ok();allow update,delete:if false;}
 match /receipts/{i}{allow read:if ok()&&role()!='entry';allow create:if ok()&&role() in ['admin','accountant','manager'];allow update,delete:if ok()&&role() in ['admin','accountant'];}
}}
